/**
 * Resume Builder Ethiopia API (payments + Telegram bot).
 * Setup and deployment: docs/payments-setup.md
 * After changing bindings, run `npx wrangler types` to refresh worker-configuration.d.ts.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "resume-builder-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Settings: set with `npx wrangler secret put <NAME>`; locally in .dev.vars (never commit it).
	// Deploys fail if any are missing, and the Worker refuses to serve if one is malformed (src/config.ts).
	// CORS_ALLOWED_ORIGINS is not really secret, but managing it here gives clean per-environment
	// values (localhost in .dev.vars, the Pages URL in production). Example production value:
	//   https://buildora.pro.et,https://resume-builder-ethiopia.pages.dev,https://*.resume-builder-ethiopia.pages.dev
	"secrets": {
		"required": [
			"DATABASE_URL",
			"TELEGRAM_BOT_TOKEN",
			"TELEGRAM_WEBHOOK_SECRET",
			"TELEGRAM_ADMIN_CHAT_ID",
			"IP_HASH_SALT",
			"CORS_ALLOWED_ORIGINS"
		]
	},
	// Per-Cloudflare-location limits (approximate by design; see Cloudflare docs).
	"ratelimits": [
		{
			// Payment submissions per client IP.
			"name": "PAYMENT_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			// Status checks per payment token (the page polls every 3 seconds).
			"name": "STATUS_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 30, "period": 60 }
		},
		{
			// AI rewrites per payment token. Each call uses Workers AI neurons.
			"name": "AI_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			// Email (lead) submissions per client IP.
			"name": "LEAD_LIMITER",
			"namespace_id": "1004",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	// Workers AI (model: @cf/qwen/qwen3-30b-a3b-fp8, see src/ai/rewrite.ts).
	// Note: `wrangler dev` always runs AI remotely on your Cloudflare account (uses neurons).
	"ai": {
		"binding": "AI",
		"remote": true
	}
}
