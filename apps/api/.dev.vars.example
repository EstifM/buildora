# Copy to .dev.vars for local development (.dev.vars is git-ignored). Never commit real values.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token"
# 16-256 chars of letters, digits, _ and - (e.g. `openssl rand -hex 32`). The Worker refuses weaker values.
TELEGRAM_WEBHOOK_SECRET="change-me"
# Your numeric Telegram user ID (send /start to the bot to see it).
TELEGRAM_ADMIN_CHAT_ID="123456789"
# At least 16 random characters, e.g. `openssl rand -hex 32`.
IP_HASH_SALT="change-me"
# Website origins allowed to call the API (comma-separated). "*." allows one subdomain level,
# e.g. Pages preview deployments. Production example:
#   https://resume-builder-ethiopia.pages.dev,https://*.resume-builder-ethiopia.pages.dev
CORS_ALLOWED_ORIGINS="http://localhost:3000"
